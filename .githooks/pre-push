#!/bin/sh
HOOKS_DIR=$(git rev-parse --show-toplevel)/.githooks
FAILED=0
while read -r _l local_sha _r remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    D=$(git show --unified=0 --no-color "$local_sha" 2>/dev/null)
  else
    D=$(git diff --unified=0 --no-color "$remote_sha..$local_sha" 2>/dev/null)
  fi
  printf '%s\n' "$D" | /usr/bin/python3 "$HOOKS_DIR/secret-scan.py" || FAILED=1
done
[ $FAILED -ne 0 ] && { echo "  Push refused: secret is already in a COMMIT - rewrite history."; exit 1; }
exit 0
