# Copy this file to `.env` and paste your Cloudflare API token.
# `.env` is git-ignored and must NEVER be committed or shared.
#
# Create the token at: https://dash.cloudflare.com/profile/api-tokens
# Custom token permissions needed:
#   Zone → Zone Settings → Edit
#   Zone → Zone           → Read
#   Zone → Zone WAF       → Edit   (only if you use --waf)
# Zone Resources: Include → All zones (so it works for every client domain)

CF_API_TOKEN=paste-your-token-here
